SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server only: sb_secret_... or legacy service_role JWT. Never a browser key.
SUPABASE_SERVER_KEY=
# Server-side moderation access: publishable/anon key, used with each user's JWT.
SUPABASE_PUBLISHABLE_KEY=
# Random secret, at least 32 characters; same across replicas. Never NUXT_PUBLIC.
MODERATION_SESSION_SECRET=
HOST=127.0.0.1
PORT=5173
# Exact peer IPs of your trusted reverse proxy; empty ignores forwarded headers.
TRUSTED_PROXY_IPS=
# Exact browser origin accepted for report submissions (no trailing slash).
PUBLIC_WEB_ORIGIN=https://entrehuellas.kormind.com
# Public SEO identity, shared by canonical, social cards, JSON-LD and sitemap.
# Change only after the new domain is owned, serving HTTPS and ready to migrate.
NUXT_PUBLIC_SITE_URL=https://entrehuellas.kormind.com

# Public browser tile URL, same CARTO Positron source as mobile; no Supabase secrets.
NUXT_PUBLIC_MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/light_all/{z}/{x}/{y}.png?key=API_KEY
